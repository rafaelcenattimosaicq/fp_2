VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=your_cognito_client_id
VITE_DEMO_MODE=false
VITE_DEVICES_API_URL=https://YOUR_DEVICES_API_ID.execute-api.us-east-1.amazonaws.com
VITE_POLICIES_API_URL=https://YOUR_POLICIES_API_ID.execute-api.us-east-1.amazonaws.com
VITE_FIRMWARE_API_URL=https://YOUR_FIRMWARE_API_ID.execute-api.us-east-1.amazonaws.com
VITE_VPN_API_URL=https://YOUR_VPN_API_ID.execute-api.us-east-1.amazonaws.com
# NES API — leave VITE_NES_API_URL empty so requests go through the Vite
# proxy (avoids CORS). Set the actual ALB URL in NES_PROXY_TARGET.
VITE_NES_API_URL=
NES_PROXY_TARGET=http://YOUR_ALB_DNS.us-east-1.elb.amazonaws.com
VITE_MQTT_WS_URL=ws://YOUR_ALB_DNS.us-east-1.elb.amazonaws.com/mqtt
VITE_NES_MQTT_SINK_URL=tcp://mqtt-broker.iot.local:1883
VITE_TEST_USER=test@example.com
VITE_TEST_PASSWORD=YourTestPassword
VITE_TEST_TOTP_SECRET=YOUR_TOTP_SECRET
